{
  "name": "@little-nebulae/node-env",
  "version": "0.4.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run",
    "try": "oxnode ./src/try.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.4.0",
    "@little-nebulae/result": "1.4.0",
    "@little-nebulae/system-error": "2.1.0",
    "@oxc-node/cli": "1.0.1",
    "@types/node": "26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "tsdown": "0.23.3",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.0.0",
    "@little-nebulae/result": "^1.0.0",
    "@little-nebulae/system-error": "^2.1.0",
    "@types/node": "^26.0.0",
    "type-fest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1"
}
